{
  "author": "Stephen Sorensen",
  "bin": {
    "spudly-tooling": "./dist/cli.js"
  },
  "description": "Shared developer-tooling primitives and CLI for Spudly repos: affected-test discovery, the standard actionlint invocation, and a standards drift check for the common check contract.",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@spudly/tooling",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "directory": "packages/tooling",
    "type": "git",
    "url": "git+https://github.com/spudly/eslint-config.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node scripts/runTests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "version": "0.2.0"
}
