{
  "name": "spudly-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Shared developer-tooling monorepo for Spudly repos (eciperay, memorize, design-system, and this repo): @spudly/eslint-config, with @spudly/commitlint-config and @spudly/tooling added by later tranches of #49.",
  "license": "MIT",
  "author": "Stephen Sorensen",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "changeset": "changeset",
    "check-rules": "npm run check-rules --workspace=@spudly/eslint-config",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "eslint .",
    "prepare": "husky || true",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix --cache --cache-location .eslintcache --cache-strategy content --no-warn-ignored"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
