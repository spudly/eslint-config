#!/bin/sh
npx lint-staged

# Gated stages: typecheck and tests run only when staged files can
# actually affect them. Triggers mirror what each check reads:
# - typecheck reads src/, test/, and both tsconfig files.
# - The tests import the built dist (they are packaging tests, run via
#   tsx against dist), so src/ changes reach them through the build in
#   `npm test`; test/ and scripts/ are their own inputs, and the
#   lockfile-sync test reads package.json/package-lock.json.
# The typecheck is incremental (see the typecheck script's
# --tsBuildInfoFile flags); its *.tsbuildinfo caches are gitignored.
if git diff --cached --name-only --no-renames | grep -qE '^(src/|test/|scripts/|tsconfig\.json|tsconfig\.test\.json|package\.json|package-lock\.json|eslint\.config\.ts)'; then
  npm run typecheck
  npm test
fi
